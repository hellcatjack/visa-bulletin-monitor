# Notification Method (email or sms)
# Default: email
NOTIFICATION_METHOD=email

# ===== Email Configuration =====
# SMTP settings - Examples:
# Gmail: smtp.gmail.com, port 587, use_tls=true (需要应用专用密码)
# Outlook: smtp-mail.outlook.com, port 587, use_tls=true
# QQ邮箱: smtp.qq.com, port 587, use_tls=true (需要授权码)
# 163邮箱: smtp.163.com, port 465, use_tls=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
EMAIL_FROM=your_email@gmail.com
# Multiple recipients: separate with commas (支持多个收件人，用逗号分隔)
# Examples:
#   Single: recipient@example.com
#   Multiple: recipient1@example.com,recipient2@example.com,recipient3@example.com
EMAIL_TO=recipient@example.com

# ===== SMS Configuration (Twilio) =====
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Phone Numbers (include country code, e.g., +1 for US, +86 for China)
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+8613800138000

# ===== Optional Settings =====
# Set log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
